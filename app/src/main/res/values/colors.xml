    <color name="m3_surface_container_high">#ECE6F0</color>
    <color name="m3_surface_container_highest">#E6E0E9</color>

    <!-- Outline -->
    <color name="m3_outline">#79747E</color>
    <color name="m3_outline_variant">#CAC4D0</color>

    <!-- 终端控制台专用（浅色模式下也用深色背景，模拟终端） -->
    <color name="terminal_bg">#1A1A2E</color>
    <color name="terminal_text">#E0E0E0</color>
    <color name="terminal_hint">#888899</color>
    <color name="terminal_accent">#B388FF</color>

    <!-- ============================================================ -->
    <!-- 旧颜色名称 → 映射到新配色（保持兼容，不破坏其他页面）        -->
    <!-- ============================================================ -->
    <color name="bg_root">@color/m3_background</color>
    <color name="bg_mainActivity_title_bar">@color/m3_surface</color>
    <color name="bg_title_bar">@color/m3_surface_container</color>
    <color name="bg_console">@color/terminal_bg</color>
    <color name="bg_input_bar">@color/m3_surface_container</color>
    <color name="text_console">@color/terminal_text</color>
    <color name="text_title">@color/m3_on_surface</color>
    <color name="text_hint">@color/terminal_hint</color>
    <color name="btn_pick_bg">@color/m3_primary</color>
    <color name="btn_pick_text">@color/m3_on_primary</color>
    <color name="bg_card">@color/m3_surface_container</color>
    <color name="bg_edit_text">@color/m3_surface_container_high</color>

    <!-- Selecting 页面按钮配色（保留，映射到 Material 3 tonal 色） -->
    <color name="btn_primary_bg">@color/m3_primary</color>
    <color name="btn_secondary_bg">@color/m3_secondary</color>
    <color name="btn_third_bg">#7C5CBA</color>
