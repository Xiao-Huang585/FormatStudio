<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================ -->
    <!-- Material 3 色彩令牌（浅色模式）                              -->
    <!-- Baseline Purple palette                                     -->
    <!-- ============================================================ -->

    <!-- Primary -->
    <color name="m3_primary">#6750A4</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_primary_container">#EADDFF</color>
    <color name="m3_on_primary_container">#21005D</color>

    <!-- Secondary -->
    <color name="m3_secondary">#625B71</color>
    <color name="m3_on_secondary">#FFFFFF</color>
    <color name="m3_secondary_container">#E8DEF8</color>
    <color name="m3_on_secondary_container">#1D192B</color>

    <!-- Tertiary -->
    <color name="m3_tertiary">#7D5260</color>
    <color name="m3_on_tertiary">#FFFFFF</color>
    <color name="m3_tertiary_container">#FFD8E4</color>
    <color name="m3_on_tertiary_container">#31111D</color>

    <!-- Error -->
    <color name="m3_error">#B3261E</color>
    <color name="m3_on_error">#FFFFFF</color>
    <color name="m3_error_container">#F9DEDC</color>
    <color name="m3_on_error_container">#410E0B</color>

    <!-- Background / Surface -->
    <color name="m3_background">#FEF7FF</color>
    <color name="m3_on_background">#1D1B20</color>
    <color name="m3_surface">#FEF7FF</color>
