<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================ -->
<!-- activity_main.xml — Material 3 现代化布局                     -->
<!-- ============================================================ -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity" >

    <!-- ====== 顶部应用栏 ====== -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/m3_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/MainActivity_title"
            android:textColor="@color/m3_on_surface"
            android:textSize="22sp"
            android:textStyle="normal"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:ellipsize="end"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/m3_on_surface_variant"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btn_setting"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_settings_24"
            app:tint="@color/m3_on_surface_variant"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 顶部栏底部分割线（Material 3 描边风格） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/m3_outline_variant"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== 终端控制台（MaterialCardView 描边风格） ====== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_console"
        style="@style/Widget.KgmDecoder.CardView.Terminal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:layout_constraintBottom_toTopOf="@id/input_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/sv_console"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/terminal_text"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- ====== 视频播放层 ====== -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/input_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 播放箭头提示 -->
    <ImageView
        android:id="@+id/playArrow"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/round_play_arrow_24"
        android:visibility="gone"
        android:alpha="0.9"
        android:background="@drawable/bg_card_rounded"
        android:padding="20dp"
        android:translationZ="12dp"
        app:tint="@color/m3_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ====== 底部输入栏顶部分割线 ====== -->
    <View
        android:id="@+id/input_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/m3_outline_variant"
        app:layout_constraintBottom_toTopOf="@id/input_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== 底部输入栏 ====== -->
    <LinearLayout
        android:id="@+id/input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/m3_surface_container"
        android:padding="12dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TextInputLayout 输入框 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input"
            style="@style/Widget.KgmDecoder.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            app:boxBackgroundColor="@color/m3_surface_container_high"
            android:hint="@string/MainActivity_defaultHint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textColor="@color/m3_on_surface"
                android:textColorHint="@color/m3_on_surface_variant"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:fontFamily="sans-serif" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MaterialButton 选择文件按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick"
            style="@style/Widget.KgmDecoder.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="96dp"
            android:text="@string/MainActivity_pickBtnHint" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
