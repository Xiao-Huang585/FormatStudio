<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================ -->
<!-- selecting.xml — Material 3 风格                               -->
<!-- 保持所有组件 id 不变                                           -->
<!-- ============================================================ -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:fitsSystemWindows="true">

    <!-- 顶部装饰背景（primaryContainer 色） -->
    <View
        android:id="@+id/header_bg"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@color/m3_primary_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 标题（Material 3 headlineSmall 风格） -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:gravity="start"
        android:text="@string/Selecting_title"
        android:textColor="@color/m3_on_primary_container"
        android:textSize="28sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="6dp"
        android:text="@string/Selecting_subtitle"
        android:textColor="@color/m3_on_primary_container"
        android:textSize="14sp"
        android:alpha="0.8"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 功能按钮卡片区域（MaterialCardView elevated） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/m3_surface_container"
        app:layout_constraintTop_toBottomOf="@id/header_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 按钮1：显示媒体信息（Filled primary） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ShowMediaInfo"
                style="@style/Widget.KgmDecoder.SelectingButton"
                android:layout_marginTop="4dp"
                app:backgroundTint="@color/btn_primary_bg"
                android:drawableStart="@drawable/baseline_info_24"
                android:text="@string/Selecting_showMediaInfo" />

            <!-- 按钮2：播放视频（Tonal 风格） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/PlayVideo"
                style="@style/Widget.KgmDecoder.SelectingButton"
                app:backgroundTint="@color/btn_secondary_bg"
                android:drawableStart="@drawable/round_play_arrow_24"
                android:text="@string/Selecting_playVideo" />

            <!-- 按钮3：用其他编码器 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/EncodeWithOtherEncoders"
                style="@style/Widget.KgmDecoder.SelectingButton"
                app:backgroundTint="@color/btn_third_bg"
                android:drawableStart="@drawable/encode_with_other_encoder"
                android:text="@string/Selecting_encodeWithOtherEncoders" />

            <!-- 按钮4：压缩 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/EncodeWithCompress"
                style="@style/Widget.KgmDecoder.SelectingButton"
                app:backgroundTint="@color/btn_fourth_bg"
                android:drawableStart="@drawable/encode_with_compress"
                android:text="@string/Selecting_encodeWithCompress" />

            <!-- 按钮5：裁剪 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/EncodeWithTrim"
                style="@style/Widget.KgmDecoder.SelectingButton"
                app:backgroundTint="@color/btn_fifth_bg"
                android:drawableStart="@drawable/encode_with_trim"
                android:text="@string/Selecting_encodeWithTrim" />

            <!-- 按钮6：亮度 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/EncodeWithBrightness"
                style="@style/Widget.KgmDecoder.SelectingButton"
                android:layout_marginBottom="4dp"
                app:backgroundTint="@color/btn_sixth_bg"
                android:drawableStart="@drawable/encode_with_brightness"
                android:text="@string/Selecting_encodeWithBrightness" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ========= 参数窗口（MaterialCardView elevated） ========= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/parameters_window"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="100dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/m3_surface_container_high"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 返回箭头 -->
            <ImageButton
                android:id="@+id/backArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/baseline_arrow_back_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/m3_on_surface" />

            <!-- 窗口标题 -->
            <TextView
                android:id="@+id/tv_parameters_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="24dp"
                android:text="@string/Selecting_parametersTitle"
                android:textColor="@color/m3_on_surface"
                android:textSize="24sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintEnd_toStartOf="@id/backArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 滚动内容区 -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_content_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toTopOf="@id/btn_confirm_encode"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_parameters_title">

                <FrameLayout
                    android:id="@+id/content_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </androidx.core.widget.NestedScrollView>

            <!-- 底部确认按钮（MaterialButton Filled primary） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_encode"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:text="@string/Selecting_confirm"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
