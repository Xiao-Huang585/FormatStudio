<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <TextView
        android:layout_width="400dp"
        android:layout_height="80dp"
        android:text="@string/Selecting_title"
        android:textColor="@color/night_text_blue"
        android:textSize="45dp"
        tools:layout_editor_absoluteX="-4dp"
        tools:layout_editor_absoluteY="16dp" />

    <Button
        android:id="@+id/ShowMediaInfo"
        android:layout_width="360dp"
        android:layout_height="46dp"
        android:layout_marginTop="135dp"
        android:background="@color/bg_root"
        android:text="@string/Selecting_showMediaInfo"
        android:textColor="@color/night_text_blue"
        android:textDirection="ltr"
        android:textSize="30dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="4dp"
        android:layoutDirection="ltr"
        android:textAlignment="textStart"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/PlayVideo"
        android:layout_width="360dp"
        android:layout_height="46dp"
        android:layout_marginTop="235dp"
        android:background="@color/bg_root"
        android:text="@string/Selecting_playVideo"
        android:textColor="@color/night_text_blue"
        android:textDirection="ltr"
        android:textSize="30dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="4dp"
        android:layoutDirection="ltr"
        android:textAlignment="textStart"
        android:textAllCaps="false" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parameters_window"
        android:layout_width="380dp"
        android:layout_height="500dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="200dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.129"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/night_window_color"
            android:visibility="visible" />

        <TextView
            android:layout_width="262dp"
            android:layout_height="105dp"
            android:text="@string/Selecting_parametersTitle"
            android:textColor="@android:color/white"
            android:textSize="60dp" />

        <ImageButton
            android:id="@+id/backArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/baseline_arrow_back_24"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>